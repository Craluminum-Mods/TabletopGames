{
    "code": "playingcard",
    "class": "TabletopGames.ItemPlayingCard",
    "maxStackSize": 1,
    // fixes default transformation
    "shape": { "base": "game:block/basic/invisible" },
    "attributes": {
        "handbook": {
            "groupBy": ["tabletopgames:playingcard"],
            "extraSections": [
                // {
                //     "title": "tabletopgames:item-handbooktitle-playingcard-howtoobtain",
                //     "text": "tabletopgames:item-handbooktext-playingcard-howtoobtain"
                // },
                {
                    "title": "tabletopgames:item-handbooktitle-playingcard-interactions",
                    "text": "tabletopgames:item-handbooktext-playingcard-interactions"
                }
            ]
        },
        "shelvable": true,
        "displaycaseable": true,
        "onshelfTransform": { "rotation": { "x": 0, "y": 45, "z": 0 } },
        "groundStorageTransform": { "rotation": { "x": 0, "y": 45, "z": 0 } },
        "name": {
            "*": ["tabletopgames:item-playingcard"]
        },
        "description": {
            "*": [
                // display only pack info to avoid possible cheating
                "tabletopgames:itemdesc-playingcard-pack",
                ": ",
                "tabletopgames:itemdesc-playingcard-pack-{pack}",
                "<br><br>",
                "tabletopgames:itemdesc-playingcard-toolmodeinfo"
            ]
        },
        "shape": {
            "flipped-true": { "base": "tabletopgames:item/playingcard-flipped" },
            "*": { "base": "tabletopgames:item/playingcard" }
        },
        "textures": {
            "rank-joker": {
                "front": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [
                        //
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/image-0-joker-{color}" }
                    ]
                },
                "back": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [{ "base": "tabletopgames:item/playingcard/pack-{pack}/back" }]
                },
                "side": { "base": "game:block/cloth/paper/blank-small" }
            },
            "@rank-(j|q|k|a)": {
                "front": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [
                        //
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/rank-{rank}-{color}" },
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/suit-{suit}" },
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/image-0-{rank}" }
                    ]
                },
                "back": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [{ "base": "tabletopgames:item/playingcard/pack-{pack}/back" }]
                },
                "side": { "base": "game:block/cloth/paper/blank-small" }
            },
            "*": {
                "front": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [
                        //
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/rank-{rank}-{color}" },
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/suit-{suit}" },
                        { "base": "tabletopgames:item/playingcard/pack-{pack}/image-{suit}-{rank}" }
                    ]
                },
                "back": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [{ "base": "tabletopgames:item/playingcard/pack-{pack}/back" }]
                },
                "side": { "base": "game:block/cloth/paper/blank-small" }
            }
        },
        "safeTextures": {
            "*": {
                "front": { "base": "tabletopgames:item/playingcard/background-parchment" },
                "back": {
                    "base": "tabletopgames:item/playingcard/background-parchment",
                    "blendedOverlays": [{ "base": "tabletopgames:item/playingcard/pack-{pack}/back" }]
                },
                "side": { "base": "game:block/cloth/paper/blank-small" }
            }
        },
        "quantitySlots": {
            "*": 63
        },
        "stackingTranslaton": {
            "*": 0.00625
        },
        "packCode": {
            "pack-*": "card-{pack}"
        }
    },
    "behaviors": [
        {
            "name": "GroundStorable",
            "properties": {
                "layout": "Quadrants",
                "selectionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.00625, "z2": 1 },
                "collisionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 0, "y2": 0, "z2": 0 }
            }
        },
        { "name": "TabletopGames.PlayingCardInteractions" },
        {
            "name": "TabletopGames.PlayingCardToolModes",
            "properties": {
                "modeName": {
                    "rank-joker": [
                        //
                        "tabletopgames:itemdesc-playingcard-rank-{rank}",
                        "\t",
                        "(",
                        "color-{color}",
                        ")"
                    ],
                    "*": [
                        //
                        "tabletopgames:itemdesc-playingcard-rank-{rank}",
                        "\t",
                        "tabletopgames:itemdesc-playingcard-short-suit-{suit}",
                        "\t",
                        "(",
                        "tabletopgames:itemdesc-playingcard-suit-{suit}",
                        ")"
                    ]
                }
            }
        },
        {
            "name": "TabletopGames.InteractionHelpConstructor",
            "properties": {
                "interactions": [
                    {
                        "ActionLangCode": "tabletopgames:blockhelp-playingcard-add-1",
                        "MouseButton": "Right",
                        "HotKeyCode": "shift",
                        "ItemStacks": [
                            { "type": "item", "code": "tabletopgames:playingcard", "attributes": { "types": { "pack": "vs", "suit": "club", "rank": "2", "color": "black" } } },
                            { "type": "item", "code": "tabletopgames:playingcard", "attributes": { "types": { "pack": "vs", "suit": "diamond", "rank": "2", "color": "red" } } }
                        ]
                    },
                    {
                        "ActionLangCode": "tabletopgames:blockhelp-playingcard-add-1-flipped",
                        "MouseButton": "Right",
                        "HotKeyCode": "ctrl",
                        "ItemStacks": [{ "type": "item", "code": "tabletopgames:playingcard", "attributes": { "types": { "pack": "vs", "suit": "club", "rank": "2", "color": "black", "flipped": "true" } } }]
                    },
                    {
                        "ActionLangCode": "tabletopgames:blockhelp-playingcard-remove-1",
                        "MouseButton": "Right",
                        "HotKeyCode": "shift",
                        "RequireFreeHand": true
                    }
                ]
            }
        }
    ],
