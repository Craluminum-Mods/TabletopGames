{
    "code": "shogipiece",
    "class": "TabletopGames.ItemBoardPiece",
    "maxStackSize": 64,
    "attributes": {
        "handbook": { "groupBy": ["tabletopgames:shogipiece"] },
        "shelvable": true,
        "displaycaseable": true,
        "onDisplayTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.13, "z": 0.5 }, "scale": 0.75 },
        "onshelfTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.1, "z": 0.5 }, "scale": 0.6 },
        "groundStorageTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.13, "z": 0.5 }, "scale": 0.75 },
        "onShogiTransform": { "translation": { "x": -1.52, "y": -1.02, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0, "z": 0.5 }, "scale": 0.3 },
        "name": {
            "*": ["tabletopgames:item-shogipiece", " (", "tabletopgames:shogipiece-{type}", ")"]
        },
        "description": {
            "stone-*": ["tabletopgames:trivia-shogipiece", "blockmaterial-Stone", ": ", "rock-{stone}"],
            "wood-*": ["tabletopgames:trivia-shogipiece", "blockmaterial-Wood", ": ", "material-{wood}"]
        },
        "tabletopTags": {
            "tags": ["shogi"]
        },
        "shape": {
            "*": { "base": "tabletopgames:item/piece/shogipiece" }
        },
        // using KaiTi font and Kanji for shogi textures
        "textures": {
            "wood-*": {
                "material": { "base": "game:block/wood/debarked/{wood}" },
                "overlay": { "base": "tabletopgames:item/piece/shogipiece/kanji-whitebackground/{type}" }
            },
            "stone-*": {
                "material": { "base": "game:block/stone/rock/{stone}1" },
                "overlay": { "base": "tabletopgames:item/piece/shogipiece/kanji-whitebackground/{type}" }
            }
        },
        "rotateWhenPlacedOnBoard": true
    },
    "behaviors": [
        {
            "name": "GroundStorable",
            "properties": {
                "layout": "Quadrants",
                "selectionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.0625, "z2": 1 },
                "collisionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 0, "y2": 0, "z2": 0 }
            }
        },
        {
            "name": "TabletopGames.AdvancedToolModes",
            "properties": {
                "toolModes": {
                    "*": [
                        { "setVariants": { "type": "gyokusho" } }, //                     King (gyokusho)
                        { "setVariants": { "type": "osho" } }, //                         King (osho)
                        { "setVariants": { "type": "kinsho" } }, //                       Gold general (kinsho)

                        { "setVariants": { "type": "ginsho" }, "linebreak": true }, //    Silver general (ginsho)
                        { "setVariants": { "type": "kyosha" } }, //                       Lance (kyosha)
                        { "setVariants": { "type": "keima" } }, //                        Knight (keima)
                        { "setVariants": { "type": "kakugyo" } }, //                      Bishop (kakugyo)
                        { "setVariants": { "type": "hisha" } }, //                        Rook (hisha)
                        { "setVariants": { "type": "fuhyo" } }, //                        Pawn (fuhyo)

                        { "setVariants": { "type": "narigin" }, "linebreak": true }, //   Promoted silver (narigin)
                        { "setVariants": { "type": "narikyo" } }, //                      Promoted lance (narikyo)
                        { "setVariants": { "type": "narikei" } }, //                      Promoted knight (narikei
                        { "setVariants": { "type": "ryuma" } }, //                        Promoted bishop (ryuma)
                        { "setVariants": { "type": "ryuo" } }, //                         Promoted rook (ryuo)
                        { "setVariants": { "type": "tokin" } } //                         Promoted pawn (tokin)
                    ]
                }
            }
        }
    ],
    "creativeinventoryStacks": [
        {
            "tabs": ["tabletopgames"],
            "stacks": [
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "gyokusho", "wood": "birch" } } }, //    King (gyokusho)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "osho", "wood": "birch" } } }, //        King (osho)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "kinsho", "wood": "birch" } } }, //      Gold general (kinsho)

                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "ginsho", "wood": "birch" } } }, //      Silver general (ginsho)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "kyosha", "wood": "birch" } } }, //      Lance (kyosha)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "keima", "wood": "birch" } } }, //       Knight (keima)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "kakugyo", "wood": "birch" } } }, //     Bishop (kakugyo)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "hisha", "wood": "birch" } } }, //       Rook (hisha)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "fuhyo", "wood": "birch" } } }, //       Pawn (fuhyo)

                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "narigin", "wood": "birch" } } }, //     Promoted silver (narigin)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "narikyo", "wood": "birch" } } }, //     Promoted lance (narikyo)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "narikei", "wood": "birch" } } }, //     Promoted knight (narikei)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "ryuma", "wood": "birch" } } }, //       Promoted bishop (ryuma)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "ryuo", "wood": "birch" } } }, //        Promoted rook (ryuo)
                { "type": "item", "code": "shogipiece", "attributes": { "types": { "type": "tokin", "wood": "birch" } } } //        Promoted pawn (tokin)
            ]
        }
    ],
    "guiTransform": {
        "rotation": { "x": 105, "y": 0, "z": 0 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 1.65
    },
    "fpHandTransform": {
        "translation": { "x": 0, "y": 0.5, "z": 0 },
        "rotation": { "x": 22, "y": 180, "z": 0 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 0.9
    },
    "groundTransform": {
        "translation": { "x": 0, "y": 0, "z": 0 },
        "rotation": { "x": 0, "y": 0, "z": 0 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 }
    },
    "tpHandTransform": {
        "translation": { "x": -2, "y": -0.5, "z": -2 },
        "rotation": { "x": -90, "y": 0, "z": -63 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 0.25
    }
}
