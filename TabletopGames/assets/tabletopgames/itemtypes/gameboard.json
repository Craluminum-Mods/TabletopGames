                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "kapok" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "baldcypress" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "larch" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "redwood" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "ebony" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "walnut" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "purpleheart" } } },

                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "andesite" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "chalk" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "chert" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "conglomerate" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "limestone" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "claystone" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "stone": "granite" } } },
