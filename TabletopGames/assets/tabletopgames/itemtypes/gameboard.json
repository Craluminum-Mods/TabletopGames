{
    "code": "gameboard",
    "class": "TabletopGames.ItemShapeTexturesFromAttributes",
    "maxStackSize": 64,
    "attributes": {
        "handbook": { "groupBy": ["tabletopgames:gameboard"] },
        "shelvable": true,
        "displaycaseable": true,
        "onDisplayTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.13, "z": 0.5 }, "scale": 0.75 },
        "onshelfTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.1, "z": 0.5 }, "scale": 0.6 },
        "groundStorageTransform": { "translation": { "x": 0, "y": 0.5, "z": 0.1 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0, "z": 0.5 }, "scale": 2.5 },
        "name": {},
        "description": {
            "stone-*": ["blockmaterial-Stone", ": ", "rock-{stone}"],
            "wood-*": ["blockmaterial-Wood", ": ", "material-{wood}"]
        },
        // "redirectTo": {
        //     "stone-*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "stone": "granite" } } },
        //     "wood-*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "wood": "oak" } } },
        //     "*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "wood": "oak" } } }
        // },
        "tabletopTags": [],
        "shape": {
            "*": { "base": "tabletopgames:block/board/16x16" }
        },
        "textures": {
            "wood-*": { "material": { "base": "game:block/wood/debarked/{wood}" } },
            "stone-*": { "material": { "base": "game:block/stone/rock/{stone}1" } }
        }
    },
    "behaviors": [
        {
            "name": "GroundStorable",
            "properties": {
                "layout": "SingleCenter",
                "selectionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.0625, "z2": 1 },
                "collisionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 0, "y2": 0, "z2": 0 }
            }
        }
    ],
    "creativeinventoryStacks": [
        {
            "tabs": ["tabletopgames"],
            "stacks": [
                { "type": "item", "code": "gameboard", "attributes": { "types": { "stone": "granite" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "wood": "oak" } } }
            ]
        }
    ],
    "heldTpIdleAnimation": "holdbothhandslarge",
    "heldTpUseAnimation": "twohandplaceblock",
    "guiTransform": {
        "rotation": { "x": -35, "y": -30, "z": 0 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 1.6
    },
    "groundTransform": {
        "translation": { "x": 0, "y": 0, "z": 0 },
        "rotation": { "x": 0, "y": -45, "z": 0 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 5
    },
    "fpHandTransform": {
        "translation": { "x": 0, "y": 0.25, "z": 0.5 }
    },
    "tpHandTransform": {
        "translation": { "x": -1.1, "y": 0, "z": -0.6 },
        "rotation": { "x": -80, "y": 0, "z": -100 },
        "origin": { "x": 0.5, "y": 0, "z": 0.5 },
        "scale": 0.5
    }
