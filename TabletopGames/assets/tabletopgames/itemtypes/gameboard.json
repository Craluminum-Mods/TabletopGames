{
    "code": "gameboard",
    "class": "TabletopGames.ItemIntermediate",
    "maxStackSize": 64,
    "attributes": {
        "handbook": { "groupBy": ["tabletopgames:gameboard"] },
        "moldrackable": true,
        "shelvable": true,
        "displaycaseable": true,
        "onmoldrackTransform": { "translation": { "x": 0.15, "y": -0, "z": -1.55 }, "rotation": { "x": 0, "y": -5, "z": 90 }, "scale": 2.5 },
        "onDisplayTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.13, "z": 0.5 }, "scale": 0.75 },
        "onshelfTransform": { "translation": { "x": 0, "y": 0.4, "z": 0 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0.1, "z": 0.5 }, "scale": 0.6 },
        "groundStorageTransform": { "translation": { "x": 0, "y": 0.5, "z": 0.1 }, "rotation": { "x": -90, "y": 0, "z": 0 }, "origin": { "x": 0.5, "y": 0, "z": 0.5 }, "scale": 2.5 },
        "name": {
            "type-generic": null,
            "type-*": ["multistepcrafting-{type}"]
        },
        "description": {
            "type-generic::stone-*": ["blockmaterial-Stone", ": ", "rock-{stone}"],
            "type-generic::wood-*": ["blockmaterial-Wood", ": ", "material-{wood}"],
            "stone-*": ["blockmaterial-Stone", ": ", "rock-{stone}"],
            "wood-*": ["blockmaterial-Wood", ": ", "material-{wood}"]
        },
        // "redirectTo": {
        //     "stone-*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "stone": "granite" } } },
        //     "wood-*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "wood": "oak" } } },
        //     "*": { "type": "block", "code": "tabletopgames:gameboard", "attributes": { "types": { "wood": "oak" } } }
        // },
        "shape": {
            "type-generic": { "base": "tabletopgames:block/board/16x16" },
            "type-chessboard_step*": { "base": "tabletopgames:block/board/16x16-withtopface-overlay2" }
        },
        "textures": {
            "type-generic::wood-*": { "material": { "base": "game:block/wood/debarked/{wood}" } },
            "type-generic::stone-*": { "material": { "base": "game:block/stone/rock/{stone}1" } },

            // chessboard stages
            "type-chessboard_step1::wood-*::primarystone-*": {
                "material": { "base": "game:block/wood/debarked/{wood}" },
                "primary": { "base": "game:block/stone/rock/{primarystone}1", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/transparent" }
            },
            "type-chessboard_step1::wood-*::primarywood-*": {
                "material": { "base": "game:block/wood/debarked/{wood}" },
                "primary": { "base": "game:block/wood/debarked/{primarywood}", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/transparent" }
            },
            "type-chessboard_step1::stone-*::primarystone-*": {
                "material": { "base": "game:block/stone/rock/{stone}1" },
                "primary": { "base": "game:block/stone/rock/{primarystone}1", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/transparent" }
            },
            "type-chessboard_step1::stone-*::primarywood-*": {
                "material": { "base": "game:block/stone/rock/{stone}1" },
                "primary": { "base": "game:block/wood/debarked/{primarywood}", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/transparent" }
            },

            "type-chessboard_step2::wood-*::primarystone-*": {
                "material": { "base": "game:block/wood/debarked/{wood}" },
                "primary": { "base": "game:block/stone/rock/{primarystone}1", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/stone/rock/{secondarystone}1", "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] }
            },
            "type-chessboard_step2::wood-*::primarywood-*": {
                "material": { "base": "game:block/wood/debarked/{wood}" },
                "primary": { "base": "game:block/wood/debarked/{primarywood}", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/wood/debarked/{secondarywood}", "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] }
            },
            "type-chessboard_step2::stone-*::primarystone-*": {
                "material": { "base": "game:block/stone/rock/{stone}1" },
                "primary": { "base": "game:block/stone/rock/{primarystone}1", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/stone/rock/{secondarystone}1", "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] }
            },
            "type-chessboard_step2::stone-*::primarywood-*": {
                "material": { "base": "game:block/stone/rock/{stone}1" },
                "primary": { "base": "game:block/wood/debarked/{primarywood}", "rotation": 90, "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] },
                "secondary": { "base": "game:block/wood/debarked/{secondarywood}", "blendedOverlays": [{ "base": "tabletopgames:block/board/chess/8x8", "blendMode": "OverlayCutout" }] }
            }
        },
        "multiStepCrafting": {
            "type-generic": [
                // {
                //     "triggerBy": { "type": "item", "code": "game:stone-*", "quantity": 2, "name": "stone", "skipVariants": ["meteorite-iron"] },
                //     "setStackMaterials": { "type": "chessboard_step1", "primarystone": "{stone}" }
                // },
                {
                    "triggerBy": { "type": "item", "code": "game:plank-*", "name": "wood" },
                    "setStackMaterials": { "type": "chessboard_step1", "primarywood": "{wood}", "size": "8x8" }
                },

                // go boards
                {
                    "triggerBy": { "type": "item", "code": "game:charcoal" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "carbonblack" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:ore-bituminouscoal" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "carbonblack" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:coke" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "cokeblack" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:stone-chalk" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "chalkwhite" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:stone-limestone" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "limewhite" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:nugget-malachite" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "verdigris" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:ore-lapislazuli" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "ultramarine" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                },
                {
                    "triggerBy": { "type": "item", "code": "game:ore-cinnabar" },
                    "convertTo": { "type": "block", "code": "tabletopgames:goboard" },
                    "copyAttributes": true,
                    "setStackMaterials": { "size": "19x19", "color": "cinnabar" },
                    "consumeIngredient": false,
                    "removeStackMaterials": ["type"]
                }
            ],

            // chessboard
            "type-chessboard_step1": [
                // {
                //     "triggerBy": { "type": "item", "code": "game:stone-*", "quantity": 2, "name": "stone", "skipVariants": ["meteorite-iron"] },
                //     "setStackMaterials": { "type": "chessboard_step2", "secondarystone": "{stone}", "size": "8x8" }
                // },
                {
                    "triggerBy": { "type": "item", "code": "game:plank-*", "name": "wood" },
                    "setStackMaterials": { "type": "chessboard_step2", "secondarywood": "{wood}" }
                }
            ],
            "type-chessboard_step2": [
                {
                    "triggerBy": { "type": "item", "code": "game:chisel-*", "isTool": true },
                    "convertTo": { "type": "block", "code": "tabletopgames:chessboard" },
                    "removeStackMaterials": ["type"],
                    "copyAttributes": true
                }
            ]
        }
    },
    "behaviors": [
        {
            "name": "GroundStorable",
            "properties": {
                "layout": "SingleCenter",
                "selectionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.0625, "z2": 1 },
                "collisionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 0, "y2": 0, "z2": 0 }
            }
        }
    ],
    "creativeinventoryStacks": [
        {
            "tabs": ["tabletopgames"],
            "stacks": [
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "birch" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "oak" } } },
                { "type": "item", "code": "gameboard", "attributes": { "types": { "type": "generic", "wood": "maple" } } },
